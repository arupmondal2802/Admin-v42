# -------------------------------------------------------------
# A BIG ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# -------------------------------------------------------------

# --- Server & Deployment Configuration ---
PORT=3000
NODE_ENV=development

# Cloudflare Workers Edge Admin Backend URL
VITE_CLOUDFLARE_WORKER_URL=https://a-big-engine-admin-backend.abigengine.workers.dev
VITE_BACKEND_URL=https://a-big-engine-admin-backend.abigengine.workers.dev

# --- Database (Neon PostgreSQL) ---
# Optional: Direct PostgreSQL connection string (otherwise resolved via Cloudflare admin backend)
DATABASE_URL=

# --- AI & Cloud Services ---
# Google Gemini API key for smart chatbot and automated summaries
GEMINI_API_KEY=

# Google Maps Platform Key (for address autocompletion & geocoding)
GOOGLE_MAPS_PLATFORM_KEY=

# --- Notifications & Communication ---
# SendGrid Email Service
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@abigengine.com

# MSG91 SMS Service
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ABGENG

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@abigengine.com

# --- Google Sheets Integration ---
# Default Google Apps Script Web App URL for data synchronization fallback
GOOGLE_SHEETS_URL=

